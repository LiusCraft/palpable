{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LiusCraft/palpable/protocol/palpable.schema.json",
  "title": "PalpableMessage",
  "description": "可感设备协议（文本帧）。音频为独立的二进制 Opus 帧，不在此 schema 内。设备↔服务端所有 JSON 消息都必须匹配 oneOf 中的一项。",
  "oneOf": [
    { "$ref": "#/$defs/Hello" },
    { "$ref": "#/$defs/HelloProof" },
    { "$ref": "#/$defs/Wake" },
    { "$ref": "#/$defs/MicState" },
    { "$ref": "#/$defs/Proximity" },
    { "$ref": "#/$defs/Location" },
    { "$ref": "#/$defs/Mcp" },
    { "$ref": "#/$defs/HelloAck" },
    { "$ref": "#/$defs/HelloChallenge" },
    { "$ref": "#/$defs/AudioDownlink" },
    { "$ref": "#/$defs/Light" },
    { "$ref": "#/$defs/Haptic" },
    { "$ref": "#/$defs/Sound" },
    { "$ref": "#/$defs/SpeakerState" },
    { "$ref": "#/$defs/Presence" },
    { "$ref": "#/$defs/ChannelState" },
    { "$ref": "#/$defs/FriendState" },
    { "$ref": "#/$defs/BindCode" },
    { "$ref": "#/$defs/BindState" },
    { "$ref": "#/$defs/Transcript" },
    { "$ref": "#/$defs/Error" }
  ],
  "$defs": {
    "AudioParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "sample_rate", "channels", "frame_duration"],
      "properties": {
        "format": { "const": "opus" },
        "sample_rate": { "const": 16000 },
        "channels": { "const": 1 },
        "frame_duration": { "const": 60, "description": "单帧毫秒数" }
      }
    },
    "Capability": {
      "enum": ["mic", "speaker", "light", "haptic", "proximity", "location", "wake", "mcp", "display"]
    },
    "MAC": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$",
      "description": "设备 MAC，小写、冒号分隔；也是设备在灵矽侧的 Device-Id"
    },
    "LightState": {
      "enum": ["idle", "listening", "thinking", "speaking", "peer_talking", "muted"]
    },
    "Hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "device_id", "audio_params", "capabilities"],
      "properties": {
        "type": { "const": "hello" },
        "device_id": { "$ref": "#/$defs/MAC" },
        "skin": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$", "description": "皮套款式，服务端据此选风格智能体；缺省或未知时用默认风格" },
        "firmware": { "type": "string", "maxLength": 64 },
        "pubkey": { "type": "string", "minLength": 1, "maxLength": 256, "description": "设备公钥 base64(SPKI DER)，ECDSA P-256；首次登记时必填，之后可省略，与已登记的不一致时拒绝。见 docs/trust.md §2" },
        "audio_params": { "$ref": "#/$defs/AudioParams" },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/Capability" },
          "uniqueItems": true
        }
      }
    },
    "HelloProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "signature"],
      "description": "对 hello.challenge 的应答：ECDSA-P256-SHA256 对 \"palpable-auth-v1\\n\" + device_id + \"\\n\" + nonce 签名，r‖s 共 64 字节，base64url 无填充",
      "properties": {
        "type": { "const": "hello.proof" },
        "signature": { "type": "string", "minLength": 86, "maxLength": 86 }
      }
    },
    "Wake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source"],
      "properties": {
        "type": { "const": "wake" },
        "source": { "enum": ["voice", "touch"] }
      }
    },
    "MicState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "state"],
      "properties": {
        "type": { "const": "mic.state" },
        "state": { "enum": ["start", "stop"] }
      }
    },
    "Proximity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "peers"],
      "properties": {
        "type": { "const": "proximity" },
        "peers": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["device_id", "strength"],
            "properties": {
              "device_id": { "type": "string", "minLength": 1, "maxLength": 64 },
              "strength": { "type": "number", "minimum": 0, "maximum": 1, "description": "归一化信号强度，越大越近" }
            }
          }
        }
      }
    },
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "lat", "lng"],
      "properties": {
        "type": { "const": "location" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "HelloAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "session_id", "audio_params"],
      "properties": {
        "type": { "const": "hello.ack" },
        "session_id": { "type": "string", "minLength": 1 },
        "audio_params": { "$ref": "#/$defs/AudioParams" }
      }
    },
    "HelloChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nonce"],
      "description": "认证挑战：服务端在 hello 之后、hello.ack 之前发送；设备须在握手时限内回 hello.proof",
      "properties": {
        "type": { "const": "hello.challenge" },
        "nonce": { "type": "string", "minLength": 43, "maxLength": 43, "description": "32 字节随机数，base64url 无填充" }
      }
    },
    "AudioDownlink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sample_rate", "frame_duration"],
      "description": "下行音频参数。AI 通道就绪后发送，早于任何下行音频帧；设备按它配置 Opus 解码器。",
      "properties": {
        "type": { "const": "audio.downlink" },
        "sample_rate": { "enum": [16000, 24000] },
        "frame_duration": { "enum": [20, 40, 60], "description": "单帧毫秒数" }
      }
    },
    "Light": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "state"],
      "properties": {
        "type": { "const": "light" },
        "state": { "$ref": "#/$defs/LightState" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "pattern": { "enum": ["solid", "breathe", "pulse"] }
      }
    },
    "Haptic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "pattern"],
      "properties": {
        "type": { "const": "haptic" },
        "pattern": { "enum": ["tap", "double_tap", "long"] }
      }
    },
    "Sound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": { "const": "sound" },
        "name": { "enum": ["connected", "joined", "left", "switched", "error", "busy", "friend", "wake"] }
      }
    },
    "SpeakerState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "state", "source"],
      "properties": {
        "type": { "const": "speaker.state" },
        "state": { "enum": ["start", "stop"] },
        "source": { "enum": ["ai", "peer", "agent"], "description": "agent 表示别人的小伙伴在频道里发言，音频参数与 audio.downlink 相同" },
        "from": { "type": "string", "description": "source 为 peer 或 agent 时的发言设备（agent 为该小伙伴的主人设备）" },
        "name": { "type": "string", "maxLength": 32, "description": "source 为 peer 或 agent 时发言者小伙伴的名字，供设备展示" }
      }
    },
    "Presence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event", "device_id", "channel"],
      "properties": {
        "type": { "const": "presence" },
        "event": { "enum": ["join", "leave"] },
        "device_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "maxLength": 32, "description": "玩偶的名字，供设备播报" },
        "channel": { "type": "string", "minLength": 1 }
      }
    },
    "Mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "description": "设备端 MCP，双向。payload 为 JSON-RPC 2.0 消息，由服务端代理与灵矽之间转发",
      "properties": {
        "type": { "const": "mcp" },
        "payload": { "type": "object" }
      }
    },
    "ChannelState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event", "channel", "name"],
      "description": "前台频道变化；设备据此切换灯色并提示",
      "properties": {
        "type": { "const": "channel.state" },
        "event": { "enum": ["joined", "switched", "left"] },
        "channel": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "maxLength": 32 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "FriendState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event", "device_id"],
      "description": "好友关系变化：asking 时小伙伴问孩子要不要交朋友；pending 表示在等家长同意。规则见 docs/trust.md §4",
      "properties": {
        "type": { "const": "friend.state" },
        "event": { "enum": ["asking", "pending", "confirmed", "removed"] },
        "device_id": { "$ref": "#/$defs/MAC" },
        "name": { "type": "string", "maxLength": 32 }
      }
    },
    "BindCode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code", "expires_in"],
      "description": "设备尚未绑定监护人：设备逐位播报绑定码，家长在家长端输入后完成绑定。绑定前服务端不提供任何服务",
      "properties": {
        "type": { "const": "bind.code" },
        "code": { "type": "string", "minLength": 6, "maxLength": 6, "description": "6 位数字" },
        "expires_in": { "type": "number", "minimum": 1, "maximum": 3600, "description": "有效秒数；过期后服务端下发新码" }
      }
    },
    "BindState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event"],
      "description": "绑定变化：bound 后进入起名流程；unbound 表示家长已解绑，设备回到出厂状态",
      "properties": {
        "type": { "const": "bind.state" },
        "event": { "enum": ["bound", "unbound"] }
      }
    },
    "Transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "role", "text"],
      "description": "与 AI 对话的文字，供有屏幕的设备显示（仅发给声明了 display 能力的设备，只发给说话的孩子自己的设备，服务端不保存）。child：孩子这一句的识别结果；ai：AI 正要说的这一句",
      "properties": {
        "type": { "const": "transcript" },
        "role": { "enum": ["child", "ai"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code", "message"],
      "properties": {
        "type": { "const": "error" },
        "code": { "enum": ["bad_message", "unsupported", "unauthorized", "internal"] },
        "message": { "type": "string" }
      }
    }
  }
}
