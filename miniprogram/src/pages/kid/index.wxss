.hero { display: flex; align-items: center; gap: 32rpx; padding: 36rpx 32rpx; }
.hero-info { display: flex; flex-direction: column; gap: 6rpx; }
.hero-pill { align-self: flex-start; margin-top: 8rpx; }

.tabs {
  --td-tab-item-tag-bg: #fff;
  --td-tab-item-tag-active-bg: var(--coral);
  --td-tab-item-active-color: #fff;
  --td-tab-item-color: var(--ink-2);
  --td-tab-nav-bg-color: transparent;
  margin: 0 -8rpx 24rpx;
  background: transparent !important;
}

.line { border-top: 3rpx dashed var(--line); }
.line-after { border-bottom: 3rpx dashed var(--line); }

.group { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0; }
.group:first-child { padding-top: 0; }
.group:last-child { padding-bottom: 0; }
.group-icon {
  width: 72rpx; height: 72rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--mint-soft); color: var(--mint);
}
.group-icon.group { background: var(--sky-soft); color: var(--sky); }

.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  display: flex; align-items: center; gap: 12rpx;
  padding: 10rpx 24rpx; border-radius: 999rpx;
  background: var(--butter-soft); border: 3rpx solid #f6e2a6;
}
.chip-name { font-weight: 700; }

.shared { padding: 20rpx 0; }
.shared:first-child { padding-top: 0; }
.shared:last-child { padding-bottom: 0; }
.shared-time { margin-left: 16rpx; }
.shared-text { margin-top: 8rpx; color: var(--ink-2); line-height: 1.7; }

.chats { display: flex; flex-direction: column; gap: 24rpx; }
.bubble-row { display: flex; align-items: flex-end; gap: 16rpx; }
.bubble-row.mine { justify-content: flex-end; }
.bubble {
  max-width: 76%;
  padding: 18rpx 24rpx;
  border-radius: 32rpx 32rpx 32rpx 8rpx;
  background: #f7f1e8;
  line-height: 1.6;
  word-break: break-all;
}
.mine .bubble { border-radius: 32rpx 32rpx 8rpx 32rpx; background: var(--coral-soft); }
.bubble-who { margin-bottom: 4rpx; }
.chats-note { text-align: center; }

.ask { border-color: #ffd0d9; box-shadow: 0 10rpx 0 #f8d4db; }
.ask-icon {
  width: 80rpx; height: 80rpx; border-radius: 50%; background: var(--berry-soft);
  display: flex; align-items: center; justify-content: center; margin-right: 20rpx;
}
.ask-actions { display: flex; justify-content: flex-end; gap: 20rpx; margin-top: 24rpx; }

.empty-art { width: 300rpx; }

.friend { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 0; }
.friend:first-child { padding-top: 0; }
.friend:last-child { padding-bottom: 0; }
.friend-dot {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: #f3ede4; color: var(--ink-3);
}
.friend-dot.on { background: var(--mint-soft); color: var(--mint); }
.friend-dot.wait { background: var(--butter-soft); color: #c99400; }
.tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 8rpx; }
.tags:empty { display: none; }

.radio { background: transparent !important; padding-left: 0 !important; padding-right: 0 !important; }
.setting-text { padding-right: 24rpx; }
.setting-text .muted { margin-top: 6rpx; }

.danger { border-color: #ffd6dd; box-shadow: 0 10rpx 0 #f9dde2; }
.danger-text { margin: 8rpx 0 28rpx; line-height: 1.6; }
