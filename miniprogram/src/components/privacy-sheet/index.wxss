.ps {
  background: var(--cream);
  border-radius: 48rpx 48rpx 0 0;
  padding: 40rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  text-align: center;
}
.ps-art { width: 160rpx; height: 160rpx; }
.ps-title { margin: 8rpx 0 20rpx; }
.ps-body { text-align: left; color: var(--ink-2); font-size: 28rpx; line-height: 1.7; }
.ps-docs { display: flex; flex-wrap: wrap; gap: 4rpx; margin: 20rpx 0 40rpx; font-size: 28rpx; }
.ps-no { margin-top: 28rpx; color: var(--ink-3); font-size: 28rpx; padding: 12rpx; }
