.ci { position: relative; display: flex; justify-content: space-between; gap: 16rpx; }
.ci-cell {
  flex: 1;
  height: 120rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 4rpx solid var(--line);
  box-shadow: 0 8rpx 0 var(--shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 800;
  color: var(--ink);
  transition: transform 0.15s, border-color 0.15s;
}
.ci-filled { border-color: var(--butter); background: var(--butter-soft); }
.ci-active { border-color: var(--coral); transform: translateY(-6rpx); }
.ci-error { border-color: var(--berry); background: var(--berry-soft); }
.ci-input {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  color: transparent;
  caret-color: transparent;
}
